// {{ screen.name }}.js - Screen-specific functionality
// Auto-generated from B-UML GUI Model

let allItems = [];
let filteredItems = [];
let allReviews = [];

// Load data when page loads
document.addEventListener('DOMContentLoaded', async () => {
    await loadData();
    initializeScreen();
});

// Load data from JSON file
async function loadData() {
    try {
        const response = await fetch('data/data.json');
        const data = await response.json();
        allItems = data.items || [];
        filteredItems = [...allItems];
        allReviews = data.reviews || [];
    } catch (error) {
        console.error('Error loading data:', error);
        allItems = [];
        filteredItems = [];
        allReviews = [];
    }
}

// Initialize screen-specific functionality
function initializeScreen() {
    {% for element in screen.view_elements %}
    {% if element.__class__.__name__ == 'DataList' %}
    // Initialize DataList: {{ element.name }}
    renderDataList_{{ element.name | replace(' ', '_') | replace('-', '_') }}();
    {% elif element.__class__.__name__ == 'InputField' %}
    {% if 'search' in element.name.lower() or 'Search' in element.name %}
    // Initialize Search Input: {{ element.name }}
    initializeSearchInput('{{ element.name }}');
    {% endif %}
    {% elif element.__class__.__name__ == 'Button' %}
    // Initialize Button: {{ element.name }}
    initializeButton('btn-{{ element.name | replace(' ', '-') | lower }}', '{{ element.actionType.name if element.actionType else 'none' }}', '{{ element.targetScreen.name if element.targetScreen else '' }}');
    {% endif %}
    {% endfor %}
}

{% for element in screen.view_elements %}
{% if element.__class__.__name__ == 'DataList' %}
// Render DataList: {{ element.name }}
function renderDataList_{{ element.name | replace(' ', '_') | replace('-', '_') }}() {
    {% for source in element.list_sources %}
    const container{{ loop.index }} = document.getElementById('list-{{ element.name }}-{{ loop.index }}');
    if (container{{ loop.index }}) {
        container{{ loop.index }}.innerHTML = '';
        
        {% if source.dataSourceClass.name == 'Review' %}
        // Handle Reviews - load from JSON data filtered by itemId
        const urlParams = new URLSearchParams(window.location.search);
        const itemId = urlParams.get('id');
        
        // Filter reviews for the current item
        const reviews = allReviews.filter(review => review.itemId == itemId);
        
        if (reviews.length === 0) {
            container{{ loop.index }}.innerHTML = '<p>No reviews yet for this item.</p>';
        } else {
            reviews.forEach(review => {
            const reviewCard = document.createElement('div');
            reviewCard.className = 'list-item review-card';
            
            let cardHTML = '';
            {% for field in source.fields %}
            if (review.{{ field.name }}) {
                let value = review.{{ field.name }};
                {% if field.name == 'date' %}
                value = formatDate(value);
                {% endif %}
                cardHTML += `
                    <div class="field">
                        <span class="field-label">{{ field.name }}:</span>
                        <span class="field-value">${value}</span>
                    </div>
                `;
            }
            {% endfor %}
            
            reviewCard.innerHTML = cardHTML;
            container{{ loop.index }}.appendChild(reviewCard);
            });
        }
        {% elif 'ItemVisualization' in screen.name %}
        // ItemVisualizationPage: Load single item from URL parameter
        const urlParams = new URLSearchParams(window.location.search);
        const itemId = urlParams.get('id');
        const items = filteredItems;
        const selectedItem = items.find(item => item.itemId == itemId);
        
        if (selectedItem) {
            // Create a separate card for each field
            {% set outer_loop_index = loop.index %}
            {% for field in source.fields %}
            if (selectedItem.{{ field.name }} !== undefined && selectedItem.{{ field.name }} !== null) {
                const fieldCard = document.createElement('div');
                fieldCard.className = 'list-item field-card';
                
                let value = selectedItem.{{ field.name }};
                
                // Format specific fields for better display
                {% if field.name == 'price' %}
                if (selectedItem.giveaway) {
                    value = 'Free (Giveaway)';
                } else {
                    value = formatCurrency(value, selectedItem.priceCurrency);
                }
                {% elif field.name == 'datePosted' %}
                value = formatDate(value);
                {% elif field.name == 'exchangeOption' or field.name == 'giveaway' %}
                value = value ? 'Yes' : 'No';
                {% endif %}
                
                fieldCard.innerHTML = `
                    <div class="field">
                        <span class="field-label">{{ field.name }}:</span>
                        <span class="field-value">${value}</span>
                    </div>
                `;
                
                container{{ outer_loop_index }}.appendChild(fieldCard);
            }
            {% endfor %}
        } else {
            container{{ outer_loop_index }}.innerHTML = '<p>Item not found.</p>';
        }
        {% else %}
        // MainPage: Display all items as clickable cards
        filteredItems.forEach(item => {
            const itemCard = document.createElement('a');
            itemCard.className = 'list-item';
            itemCard.href = 'ItemVisualizationPage.html?id=' + item.itemId;
            itemCard.setAttribute('data-item-id', item.itemId);
            
            let cardHTML = '';
            {% for field in source.fields %}
            if (item.{{ field.name }}) {
                let value = item.{{ field.name }};
                
                // Format specific fields for better display
                {% if field.name == 'price' %}
                if (item.giveaway) {
                    value = 'Free';
                } else {
                    value = formatCurrency(value, item.priceCurrency);
                }
                {% elif field.name == 'datePosted' %}
                value = formatDate(value);
                {% endif %}
                
                cardHTML += `
                    <div class="field">
                        <span class="field-label">{{ field.name }}:</span>
                        <span class="field-value">${value}</span>
                    </div>
                `;
            }
            {% endfor %}
            
            itemCard.innerHTML = cardHTML;
            container{{ loop.index }}.appendChild(itemCard);
        });
        {% endif %}
    }
    {% endfor %}
}
{% endif %}
{% endfor %}

// Initialize search input with filtering
function initializeSearchInput(inputId) {
    const searchInput = document.getElementById(inputId);
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            
            if (searchTerm === '') {
                filteredItems = [...allItems];
            } else {
                filteredItems = allItems.filter(item => {
                    return (
                        (item.title && item.title.toLowerCase().includes(searchTerm)) ||
                        (item.description && item.description.toLowerCase().includes(searchTerm)) ||
                        (item.category && item.category.toLowerCase().includes(searchTerm))
                    );
                });
            }
            
            // Re-render all data lists with filtered results
            {% for element in screen.view_elements %}
            {% if element.__class__.__name__ == 'DataList' %}
            renderDataList_{{ element.name | replace(' ', '_') | replace('-', '_') }}();
            {% endif %}
            {% endfor %}
        });
    }
}

// Initialize button with action
function initializeButton(buttonId, actionType, targetScreen) {
    const button = document.getElementById(buttonId);
    if (button) {
        button.addEventListener('click', (e) => {
            e.preventDefault();
            switch(actionType) {
                case 'Navigate':
                    if (targetScreen) {
                        window.location.href = targetScreen + '.html';
                    }
                    break;
                case 'Add':
                    console.log('Add action triggered');
                    // Implement add functionality
                    break;
                case 'Edit':
                    console.log('Edit action triggered');
                    // Implement edit functionality
                    break;
                case 'Delete':
                    console.log('Delete action triggered');
                    // Implement delete functionality
                    break;
                default:
                    console.log('Action:', actionType);
            }
        });
    }
}

// Utility function to format dates
function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Utility function to format currency
function formatCurrency(amount, currency) {
    return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: currency || 'EUR'
    }).format(amount);
}
